{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usc://schemas/evidence-ref",
  "title": "EvidenceRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceArtifactId", "span"],
  "properties": {
    "sourceArtifactId": { "type": "string", "minLength": 1 },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "locator": { "type": "string", "description": "page/line/event-id locator for non-text sources" }
      }
    },
    "validUntil": { "type": "string", "format": "date-time", "description": "decay as TTL; absent = no known expiry" },
    "extractionMethod": { "enum": ["human", "deterministic", "llm_single", "llm_ensemble"] }
  }
}
