{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usc://schemas/anti-pattern-body",
  "title": "AntiPatternBody",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "domain", "failureMode", "motifSignature", "triggeringPatternIds", "nodes", "edges", "provenance", "severity"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "failureMode": { "type": "string", "minLength": 1 },
    "motifSignature": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "triggeringPatternIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "motifs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "motifs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["scope_contains", "requires", "causes", "contrasts", "analogizes"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceArtifactIds", "rationale"],
      "properties": {
        "sourceArtifactIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "severity": { "enum": ["low", "medium", "high"] }
  }
}
